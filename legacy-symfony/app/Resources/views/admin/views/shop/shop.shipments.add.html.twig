{% extends 'admin/base.html.twig' %}

{% block title %}VedoCompro.it - ADMIN - Shop{% endblock %}

{% block body %}
    <!-- Content Wrapper. Contains page content -->

    <!-- Content Header (Page header) -->
    <section class="content-header mb-3 mt-">
        <h1>
            Shop
            <small>Nuovo Servizio di Spedizione</small>
        </h1>
        <ol class="breadcrumb p-0">

        </ol>
    </section>

    <!-- Main content -->
    <section class="content container-fluid">
        <div class="row">
            <div class="col-12 col-lg-offset-10">

            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="box">
                    <div class="box-body">
                        {% form_theme form 'bootstrap_4_layout.html.twig' %}
                        {{ form_start(form) }}
                        <div class="row">
                            <div class="col-sm-3">
                                {{ form_row(form.serviceName) }}
                            </div>
                            <div class="col-sm-2">
                                {{ form_row(form.basePrice) }}
                            </div>
                            <div class="col-sm-3">
                                {{ form_row(form.expectedDelivery) }}
                                <small class="mt-0">Specificare i due valori separati da un trattino (Es: 2-4)</small>
                            </div>
                            <div class="col-sm-3">
                                {{ form_row(form.serviceLogo) }}
                            </div>
                            <div class="col-sm-1">
                                <div class="checkbox-holder">
                                    {{ form_row(form.isActive) }}
                                </div>
                            </div>
                        </div>
                        <div class="row">

                        </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>

        </div>
    </section>
    <!-- /.content -->
    <!-- /.content-wrapper -->
    <style>

        .checkbox-holder {
            margin-top: 40px;
        }
    </style>
{% endblock %}