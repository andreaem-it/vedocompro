{% extends 'admin/base.html.twig' %}

{% block title %}VedoCompro.it - ADMIN - Shop{% endblock %}

{% block body %}
    <!-- Content Wrapper. Contains page content -->

    <!-- Content Header (Page header) -->
    <section class="content-header mb-3 mt-">
        <h1>
            Shop
            <small>Servizi Spedizione</small>
        </h1>
        <ol class="breadcrumb p-0">
            <a href="{{ url('admin_shop_shipments_add') }}" class="btn btn-primary ml-5">
                <i class="fa fa-plus-circle"></i> Nuovo Servizio
            </a>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content container-fluid">
        <div class="row">
            <div class="col-1 col-lg-offset-10">

            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="box">
                    <div class="box-body table-responsive no-padding">
                        <table class="table table-hover">
                            <tbody>
                            <tr>
                                <th>ID</th>
                                <th>Logo</th>
                                <th>Nome</th>
                                <th>Prezzo Base</th>
                                <th>Tempi consegna</th>
                                <th>Stato</th>
                                <th style="width: 80px"></th>
                            </tr>
                            {% for itm in items %}
                                <tr>
                                    <td>{{ itm.id }}</td>
                                    <td>{{ itm.serviceLogo }}</td>
                                    <td><a href="">{{ itm.serviceName }}</a></td>
                                    <td>{{ itm.basePrice }}</td>
                                    <td>{{ itm.expectedDelivery }}</td>
                                    <td>{% if itm.isActive == 1 %}
                                            <span class="badge badge-success">Pubblicato</span>
                                        {% else %}
                                            <span class="badge badge-danger">Inattivo</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <a href="" class="btn btn-primary btn-sm">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                            <a href="" class="btn btn-primary btn-sm">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <a href="{{ url('admin_shop_product_remove', { 'id' : itm.id }) }}" class="btn btn-danger btn-sm">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </section>
    <!-- /.content -->
    <!-- /.content-wrapper -->
    <style>
        .bg-gold {
            background-color: #CFB53B;
        }
        .bg-silver {
            background-color: #C0C0C0;
        }
        .bg-bronze {
            background-color: #cd7f32;
        }
    </style>
{% endblock %}