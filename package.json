{
  "name": "vedocompro",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=api\" \"npm run dev --workspace=web\"",
    "build": "npm run build --workspace=api && npm run build --workspace=web",
    "api": "npm run dev --workspace=api",
    "web": "npm run dev --workspace=web"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
