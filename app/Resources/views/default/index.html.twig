    <script>
        $(window).on('load', function () {
            $.get("https://api.ipdata.co", function (response) {
                switch (response.region) {
                    case 'Valle d\'Aosta':
                        var region = 2;
                        break;
                    case 'Piemonte':
                        var region = 3;
                        break;
                    case 'Liguria':
                        var region = 4;
                        break;
                    case 'Lombardia':
                        var region = 5;
                        break;
                    case 'Trentino Alto Adige':
                        var region = 6;
                        break;
                    case 'Veneto':
                        var region = 7;
                        break;
                    case 'Friuli Venezia Giuli':
                        var region = 8;
                        break;
                    case 'Emilia Romagna':
                        var region = 9;
                        break;
                    case 'Toscana':
                        var region = 10;
                        break;
                    case 'Umbria':
                        var region = 11;
                        break;
                    case 'Lazio':
                        var region = 12;
                        break;
                    case 'Marche':
                        var region = 13;
                        break;
                    case 'Abruzzo':
                        var region = 14;
                        break;
                    case 'Molise':
                        var region = 15;
                        break;
                    case 'Campania':
                        var region = 16;
                        break;
                    case 'Puglia':
                        var region = 17;
                        break;
                    case 'Basilicata':
                        var region = 18;
                        break;
                    case 'Calabria':
                        var region = 19;
                        break;
                    case 'Sardegna':
                        var region = 20;
                        break;
                    case 'Sicilia':
                        var region = 21;
                        break;
                    default:
                        var region = 1;
                        break;
                }
                $('select[name="form[region]"]:first').val(region);
            }, "jsonp");

        });

        if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
            $('#navbar').addClass('header-fixed');
            $('#form_submit').addClass('mt-2');
        } else {
            $(window).scroll(function () {
                var sticky = $('#navbar'),
                    display3 = $('.display-3'),
                    scroll = $(window).scrollTop();

                if (scroll >= 1) {
                    sticky.addClass('header-fixed');
                    display3.addClass('display3-space');
                }
                else {
                    sticky.removeClass('header-fixed');
                    display3.removeClass('display3-space');
                }
            });
        }
        ;
        $('#navbar-toggler').click(function () {
            //$('.navbar-collapse').toggleClass('collapse');
            $('.navbar-collapse').slideToggle(300)
        })
    </script>

    <script>
