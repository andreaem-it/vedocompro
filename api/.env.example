DATABASE_URL="postgresql://user:password@localhost:5432/vedocompro"

JWT_SECRET="change-this-to-a-secure-random-string-at-least-64-chars"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4000/auth/facebook/callback

# Cloudflare R2 (S3-compatibile) -- per AWS S3 reale: AWS_REGION=eu-west-1 (o la tua region) e
# lascia vuoto AWS_S3_ENDPOINT.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
# Nome del bucket (NON un URL)
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_S3_PUBLIC_URL=https://pub-xxxx.r2.dev

# Email
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="VedoCompro <noreply@vedocompro.it>"

# PayPal
PAYPAL_EMAIL=
PAYPAL_MODE=sandbox

# App
APP_URL=http://localhost:3000
RECAPTCHA_SECRET=
SHOP_ENABLED=false
# In sviluppo restituisce il codice verifica telefono nella risposta API.
# In produzione disattivare e collegare un provider SMS prima di abilitarla.
PHONE_VERIFICATION_DEV_MODE=true

# Frontend
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Cron (protezione endpoint /cron/*)
CRON_SECRET=

# Stripe (checkout ordini marketplace)
# Chiave segreta sk_test_/sk_live_ — MAI committare la chiave reale
STRIPE_SECRET_KEY=
# Firma webhook whsec_... (da `stripe listen` in dev o dashboard Stripe in prod)
STRIPE_WEBHOOK_SECRET=
